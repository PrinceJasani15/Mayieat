# =============================================================================
# MAYIEAT BACKEND ENVIRONMENT VARIABLES (.env.example)
# Copy this file to .env and fill in your actual credentials
# =============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mayieat_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/mayieat_db

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379

# AWS S3 Storage (24-hour Lifecycle Auto-Delete Bucket)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=mayieat-temp-scans

# Google Gemini AI Integration (Vision & Pro)
GEMINI_API_KEY=your_google_gemini_api_key

# Google OAuth 2.0 Client Authentication
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# JWT Authentication Secrets
JWT_SECRET=your_super_secret_jwt_access_key_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# External Data APIs
OPENFOODFACTS_BASE_URL=https://world.openfoodfacts.org/api/v2
